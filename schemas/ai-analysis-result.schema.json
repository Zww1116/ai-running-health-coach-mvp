{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-health-os.local/schemas/ai-analysis-result.schema.json",
  "title": "AI Analysis Result",
  "description": "Portable output shape for a provider-generated health analysis.",
  "version": "0.1.0",
  "status": "draft",
  "type": "object",
  "required": [
    "id",
    "analysisDate",
    "provider",
    "model",
    "promptVersion",
    "agentVersion",
    "inputSchemaVersion",
    "outputSchemaVersion",
    "generatedAt",
    "summary",
    "findings",
    "recommendations",
    "warningFlags",
    "uncertainty",
    "userDecision",
    "savedByUser"
  ],
  "properties": {
    "id": { "type": "string" },
    "analysisDate": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "promptVersion": { "type": "string" },
    "agentVersion": { "type": "string" },
    "inputSchemaVersion": { "type": "string" },
    "outputSchemaVersion": { "type": "string" },
    "generatedAt": { "type": "string" },
    "summary": { "type": "string" },
    "findings": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "warningFlags": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "string" },
    "userDecision": { "type": "string" },
    "savedByUser": { "type": "boolean" }
  }
}
