  "requiredFiles": [
    "PROJECT.md",
    "project/CurrentStatus.md",
    "project/SourceOfTruth.md",
    "brand/00_BrandDNA.md",
    "migration/AI_HANDOFF.md",
    "migration/NEW_AI_BOOTSTRAP_PROMPT.md"
  ],
