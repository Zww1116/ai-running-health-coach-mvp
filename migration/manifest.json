  "exclude": [
    ".env",
    ".env.*",
    "node_modules",
    "dist",
    "exports",
    "backups",
    "private-data",
    "private-profile",
    "*.sqlite",
    "*.sqlite3",
    "*.db",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.health-backup.zip",
    "*.health-backup.json",
