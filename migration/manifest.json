{
  "packName": "AI-Core-Pack",
  "packVersion": "0.1.0",
  "projectVersion": "0.1.0",
  "schemaVersion": "0.1.0",
  "promptVersion": "0.1.0",
  "agentVersion": "0.1.0",
  "privacyLevel": "Level 0 project assets only",
  "include": [
    "PROJECT.md",
    "README.md",
    "project",
    "brand",
    "product",
    "architecture",
    "security",
    "knowledge",
    "agents",
    "prompts",
    "schemas",
    "api",
    "migration/AI_HANDOFF.md",
    "migration/NEW_AI_BOOTSTRAP_PROMPT.md"
